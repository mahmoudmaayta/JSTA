# Local Development Environment
# Copy this file to .env.local and update values as needed
# .env.local is gitignored and will not be committed

# Database - Uses docker-compose PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jsta_dev

# Session Secret - Use any value for local development
SESSION_SECRET=local-dev-secret-not-for-production

# Application Configuration
NODE_ENV=development
PORT=5000

# Email Configuration (optional for local dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_email_password
# SMTP_FROM=noreply@jsta.gov.jo
